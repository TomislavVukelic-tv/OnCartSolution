{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Yarp": "Information"
        }
    },
    "AllowedHosts": "*",

    "Jwt": {
        "Authority": "https://localhost:7001",
        "Issuer": "on-cart-issuer",
        "Audience": "on-cart-cart-api",
        "SigningKey": "6518fe726f1caf2017412c1b90c93fa12c2898107b753bca9c584bd11befd2a8"
    },

    "ReverseProxy": {
        "Routes": {
            "catalog-read": {
                "ClusterId": "catalog-cluster",
                "Match": {
                    "Path": "/api/catalog/{**catch-all}",
                    "Methods": [ "GET" ]
                },
                "AuthorizationPolicy": "anonymous"
            },
            "catalog-write": {
                "ClusterId": "catalog-cluster",
                "Match": {
                    "Path": "/api/catalog/{**catch-all}",
                    "Methods": [ "POST", "PUT", "DELETE" ]
                },
                "AuthorizationPolicy": "authenticated"
            },
            "cart-route": {
                "ClusterId": "cart-cluster",
                "Match": { "Path": "/api/cart/{**catch-all}" },
                "AuthorizationPolicy": "authenticated"
            }
        },
        "Clusters": {
            "catalog": {
                "Destinations": { "d1": { "Address": "https://localhost:5002/" } }
            },
            "cart": {
                "Destinations": { "d1": { "Address": "https://localhost:5003/" } }
            }
        }
    }
}
